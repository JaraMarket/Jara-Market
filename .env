# ==============================
# 🧩 KAFKA CONFIGURATION
# ==============================

KAFKA_BROKER=kafka:9092
KAFKA_CONSUMER_GROUP_ID=jaramarket-consumer-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

